---
import Layout from '~/layouts/Layout.astro';
import HeaderTop from '~/components/headerTop.astro';
import Header from '~/components/header.astro';
import Whatsapp from '~/components/whatsapp.astro';
import Footer from '~/components/footer.astro'
import ContactForm from '~/components/contactForm.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import { buildWebPageSchema, siteURL } from '~/utils/schema';

const pageURL = `${siteURL}/contacto/`;
const jsonLd = buildWebPageSchema({
	pageURL,
	name: "Contacto",
	breadcrumb: [{ name: "Contacto", item: pageURL }]
});
---

<Layout
	title="Contacto"
	description="Contacta con Asegura-Te, tu correduría de seguros en Las Palmas de Gran Canaria. Llámanos, escríbenos o visítanos para asesorarte sin compromiso."
	canonicalURL={pageURL}
	>
	<JsonLd data={jsonLd} slot="head" />
    <section id="inicio">
		<HeaderTop />
		<Header />
	</section>
	<Whatsapp />
	<section>
      <main>
    	<h1>En Asegura-Te podemos ayudarte</h1>
       </main>
	</section>
	<ContactForm page='Contacto'/>
	<Footer />
</Layout>


<style>


    main{
        width: 85%;
        margin: 40px auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 40px;
    }

    main > div{
        width: 100%;
    }


    main > img{
        width: 80%;
        max-width: 900px;
    }


    @media only screen and (max-width: 900px)  {
        main > img{
            width: 100%;
        }
    }

</style>