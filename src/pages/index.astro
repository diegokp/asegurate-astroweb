---
import Layout from '~/layouts/Layout.astro';
import HeaderTop from '~/components/headerTop.astro';
import Header from '~/components/header.astro';
import Whatsapp from '~/components/whatsapp.astro';
import AboutUs from '~/components/aboutUs.astro';
import Companies from '~/components/companies.astro';
import Footer from '~/components/footer.astro'
import Carrousel from '~/components/carrousel.astro';
import Productos from '~/components/productos.vue';
import Preguntas from '~/components/preguntas.vue'
import JsonLd from '~/components/seo/JsonLd.astro';
import { siteURL, WEBSITE_ID, AGENCY_ID } from '~/utils/schema';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${siteURL}/#webpage`,
      "url": siteURL,
      "name": "Correduría de Seguros en Las Palmas | Asegura-Te",
      "isPartOf": { "@id": WEBSITE_ID },
      "about": { "@id": AGENCY_ID },
      "inLanguage": "es"
    }
  ]
};
---

<Layout
	title="Correduría de Seguros en Las Palmas"
	description="Correduría de seguros en Las Palmas. Comparamos seguros de hogar, auto, salud, vida y empresas con las mejores compañías. +20 años de experiencia."
	canonicalURL={siteURL}
	>
	<JsonLd data={jsonLd} slot="head" />
	<Whatsapp />
	<section id="inicio">
		<HeaderTop />
		<Header />
		<Carrousel />
	</section>
	<main>
		<AboutUs />
		<Productos client:only="vue"/>
		<Companies />
		<Preguntas client:only="vue" />
	</main>
	<Footer />
</Layout>
