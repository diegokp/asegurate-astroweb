---
import Layout from '~/layouts/Layout.astro';
import HeaderTop from '~/components/headerTop.astro';
import Header from '~/components/header.astro';
import Whatsapp from '~/components/whatsapp.astro';
import Footer from '~/components/footer.astro'
import BlogPage from '~/components/blogPage.astro';
import { getCollection, render} from "astro:content";
import { ogImageFromPublic, stripLeadingEmoji } from '~/utils/seo';
import { siteURL, buildBlogPostSchema } from '~/utils/schema';

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Canonical con barra final: es la URL que sirve el hosting (la versión sin barra redirige con 301).
const canonicalURL = `${siteURL}/blog/${post.id}/`;
const og = await ogImageFromPublic(post.data.image);
const ogImage = og.url;
const publishDateISO = post.data.publishDate instanceof Date
	? post.data.publishDate.toISOString()
	: new Date(post.data.publishDate).toISOString();

const metaTitle = stripLeadingEmoji(post.data.title);
const metaDescription = post.data.description
	?? `${metaTitle} — Consejos y asesoramiento de seguros en Las Palmas de Gran Canaria. Asegura-Te, tu correduría de confianza.`;

const jsonLd = buildBlogPostSchema({
	pageURL: canonicalURL,
	blogURL: `${siteURL}/blog/`,
	headline: metaTitle,
	description: metaDescription,
	datePublished: publishDateISO,
	dateModified: post.data.updateDate?.toISOString(),
	image: { url: ogImage, width: og.width, height: og.height }
});
---

<Layout
	title={metaTitle}
	description={metaDescription}
	canonicalURL={canonicalURL}
	ogImage={ogImage}
	ogImageMeta={{ width: og.width, height: og.height, type: og.type }}
	ogImageAlt={post.data.imageAlt}
	schema={jsonLd}
	ogType="article"
	>
	<Whatsapp />
	<section id="inicio">
		<HeaderTop />
		<Header />
	</section>
    <BlogPage
        title={post.data.title}
        image={post.data.image}
        alt={post.data.imageAlt}
        date={post.data.excerpt}
		href={post.data.link}
    >
        <div slot="article" class="md-content">
            <Content/>
        </div>
    </BlogPage>
	<Footer />
</Layout>

<style>
  .md-content :global(ul) {
    list-style: none;
    padding-left: 0;
    margin-left: 0;
  }
</style>
