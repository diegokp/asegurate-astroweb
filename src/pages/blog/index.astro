---
import Layout from '~/layouts/Layout.astro';
import HeaderTop from '~/components/headerTop.astro';
import Header from '~/components/header.astro';
import Whatsapp from '~/components/whatsapp.astro';
import Footer from '~/components/footer.astro'
import CardBlog from '~/components/cardBlog.astro';
import Articulos from '~/components/articulos.vue'

import type { CollectionEntry } from 'astro:content';
import { getCollection } from "astro:content";

const posts = (
  await getCollection(
    'blog',
    ({ data }: CollectionEntry<'blog'>) => data.last == false
  )
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const postsDraft = (
  await getCollection(
    'blog',
    ({ data }: CollectionEntry<'blog'>) => data.last == true
  )
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

import { siteURL, buildBlogIndexSchema, BLOG_NAME } from '~/utils/schema';
import { stripLeadingEmoji } from '~/utils/seo';
const blogURL = `${siteURL}/blog/`;

const allPosts = [...postsDraft, ...posts];

const jsonLd = buildBlogIndexSchema({
  pageURL: blogURL,
  name: BLOG_NAME,
  description: "Consejos, artículos y novedades sobre seguros para particulares y empresas.",
  posts: allPosts.map((post) => ({
    url: `${siteURL}/blog/${post.id}/`,
    headline: stripLeadingEmoji(post.data.title),
    datePublished: (post.data.publishDate instanceof Date ? post.data.publishDate : new Date(post.data.publishDate)).toISOString(),
    image: post.data.image.startsWith('http') ? post.data.image : `${siteURL}${post.data.image}`
  }))
});
---

<Layout
	title="Blog de Seguros — Consejos y Artículos"
	description="Artículos y consejos sobre seguros para particulares y empresas en Las Palmas. Aprende a proteger lo que más te importa con Asegura-Te."
	canonicalURL={blogURL}
	schema={jsonLd}
	>
	<Whatsapp />
	<section id="inicio">
		<HeaderTop />
		<Header />
	</section>
	<section>
      <main>
    	<h1>Últimos artículos</h1>
        <Articulos client:only="vue"></Articulos>
    	</main>
	</section>
	<Footer />
</Layout>


<style>

    main{
        width: 85%;
        margin: 40px auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 40px;
    }

    main > div{
        width: 100%;
    }


    main > img{
        width: 80%;
        max-width: 900px;
    }


    @media only screen and (max-width: 900px)  {
        main > img{
            width: 100%;
        }
    }

</style>
