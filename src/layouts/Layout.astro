---
import "~/styles/index.css"
import JsonLd from '~/components/seo/JsonLd.astro';
import { site } from '~/config/site';
import { siteURL, buildAgencySchema, buildWebsiteSchema, type PageSchema } from '~/utils/schema';
import { truncateWords, type OgImage } from '~/utils/seo';

interface Props {
	title: string;
	description: string;
	canonicalURL?: string;
	/** URL absoluta de la imagen OG. Si no se pasa, se usa la de `site.ogImage`. */
	ogImage?: string;
	/** Dimensiones y tipo reales de `ogImage` (ver `ogImageFromPublic`). Si faltan, no se declaran. */
	ogImageMeta?: Omit<OgImage, 'url'>;
	ogImageAlt?: string;
	ogType?: string;
	/** Valor de `<meta name="robots">`. Con `noindex` y sin `canonicalURL` no se emite canonical. */
	robots?: string;
	/** Nodos JSON-LD de la página. Layout los une a la agencia y al sitio en UN solo @graph. */
	schema?: PageSchema;
	/** `false` = sin JSON-LD (404). */
	jsonLd?: boolean;
}

const { title, description, canonicalURL, ogImage, ogImageMeta, ogImageAlt, ogType = "website", robots = "index, follow", schema, jsonLd = true } = Astro.props;

const graphJsonLd = {
	"@context": "https://schema.org",
	"@graph": [buildAgencySchema(), buildWebsiteSchema(), ...(schema?.["@graph"] ?? [])]
};

const makeTitle = title
  ? title + " | " + site.name
  : "Correduría de Seguros en Las Palmas | " + site.name;

const makeDescription = description
  ? truncateWords(description, 160)
  : "Descubre Asegura-Te, la correduría de Seguros en Las Palmas que te brinda confianza y seguridad. Protege lo que más importa. ¡Contáctanos hoy!";

// Canonical: el que pase la página; si no, la propia URL (con barra final, como sirve el hosting).
// Una página noindex sin canonical explícito no emite canonical (p. ej. la 404).
const makeCanonical = canonicalURL ?? (robots.includes("noindex") ? undefined : new URL(Astro.url.pathname, siteURL).toString());

// Imagen OG: la de la página o la por defecto, siempre con dimensiones reales o sin ellas.
const makeImage = ogImage ?? `${siteURL}${site.ogImage.path}`;
const imageMeta = ogImage
	? ogImageMeta
	: { width: site.ogImage.width, height: site.ogImage.height, type: site.ogImage.type };
const makeImageAlt = ogImageAlt ?? site.ogImage.alt;
---

<!doctype html>
<html lang={site.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={makeDescription}>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{makeCanonical && <link rel="canonical" href={makeCanonical} />}
		<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content={robots} />

		<link rel="mask-icon" href="/images/safari-pinned-tab.svg" color="#F4D235">
		<meta name="msapplication-TileColor" content="#da532c">
		<meta name="theme-color" content="#ffffff">

		<!-- Open Graph -->
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={makeTitle} />
		{makeCanonical && <meta property="og:url" content={makeCanonical} />}
		<meta property="og:description" content={makeDescription} />
		<meta property="og:image" content={makeImage} />
		<meta property="og:image:secure_url" content={makeImage} />
		{imageMeta?.type && <meta property="og:image:type" content={imageMeta.type} />}
		{imageMeta?.width && <meta property="og:image:width" content={String(imageMeta.width)} />}
		{imageMeta?.height && <meta property="og:image:height" content={String(imageMeta.height)} />}
		<meta property="og:image:alt" content={makeImageAlt} />
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="es_ES" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={makeTitle} />
		<meta name="twitter:description" content={makeDescription} />
		<meta name="twitter:image" content={makeImage} />
		<meta name="twitter:image:alt" content={makeImageAlt} />

		<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">

		<!-- JSON-LD: un solo @graph por página (InsuranceAgency + WebSite + nodos de la página) -->
		{jsonLd && <JsonLd data={graphJsonLd} />}

		<slot name="head" />

		<title>{makeTitle}</title>
		<!-- --FONTAWESOME-- -->
		<script src="https://kit.fontawesome.com/e044e0c03c.js" crossorigin="anonymous"></script>
		<!-- --PLAUSIBLE-- -->
		<script defer data-domain="aseguratte.es" src="https://plausible.io/js/script.js"></script>
		<!-- --cookies-script-- -->
		<script type="text/javascript" charset="UTF-8" src="//cdn.cookie-script.com/s/49059b49d617a458284b7a6a7c644dfe.js"></script>
	</head>
	<body>
		<slot />
	</body>
</html>
